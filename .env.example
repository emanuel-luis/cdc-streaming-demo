# Local demo only: every credential below is a throwaway value for a stack bound to 127.0.0.1.
# Copy to .env to override; compose.yaml falls back to these same defaults when .env is absent.

# Postgres (source database). POSTGRES_HOST and the port are what host-side tools use.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cdc_demo
POSTGRES_USER=cdc_owner
POSTGRES_PASSWORD=cdc_owner_pw

# Replication role for Debezium, created by postgres/initdb/02-cdc-role.sh.
CDC_DB_USER=cdc_reader
CDC_DB_PASSWORD=cdc_reader_pw

# Kafka: bootstrap for host-side tools; containers use kafka:29092 (set in compose.yaml).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CDC_TOPIC=cdc.public.orders
# Any 22-character base64 id works for a single-node KRaft cluster; changing it needs fresh volumes.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Schema Registry: URL for host-side tools (`cdc-demo check-schema`); containers use
# http://schema-registry:8081 (set in compose.yaml). The subject is <CDC_TOPIC>-value.
SCHEMA_REGISTRY_URL=http://localhost:8081

# S3-compatible storage (RustFS). Containers use http://s3:9000 (set in compose.yaml).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=cdc_demo_admin
S3_SECRET_KEY=cdc_demo_secret
S3_REGION=us-east-1
LAKE_ROOT=s3a://cdc-demo

# Streaming consumer tunables.
CONSUMER_TRIGGER_INTERVAL=10 seconds
CONSUMER_MAX_OFFSETS_PER_TRIGGER=10000
CONSUMER_APP_ID=orders-cdc-consumer-v1

# Spark. SPARK_IVY_DIR stays unset locally; the image bakes /opt/spark-ivy.
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=1g

# Marts and dashboard. Containers use /warehouse (a volume, set in compose.yaml); host-side runs
# write ./warehouse by default. DBT_PROJECT_DIR is where the dbt project lives (default ./dbt).
# WAREHOUSE_DIR=warehouse

# Mutator: operations per second, optional seed, operation mix, cancel probability.
MUTATOR_RATE=20
# MUTATOR_SEED=42
MUTATOR_INSERT_WEIGHT=0.5
MUTATOR_UPDATE_WEIGHT=0.4
MUTATOR_DELETE_WEIGHT=0.1
MUTATOR_CANCEL_PROBABILITY=0.1

# Host ports, all published on 127.0.0.1 only (POSTGRES_PORT above is shared with the client side).
KAFKA_PORT=9092
SCHEMA_REGISTRY_PORT=8081
CONNECT_PORT=8083
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
SPARK_UI_PORT=4040
KAFKA_UI_PORT=8090
DASHBOARD_PORT=8501

# SQL Server path (profile `mssql`, `make mssql-demo`): the demo refuses to start unless you accept
# Microsoft's SQL Server Developer EULA yourself. There is no default.
# MSSQL_ACCEPT_EULA=Y
# Same throwaway-credentials rule as above. SQL Server's password policy needs 8+ characters with
# three of: upper, lower, digit, symbol. sa only runs mssql/init/01_setup.sql.
MSSQL_SA_PASSWORD=Cdc_sa_pw_1!
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DB=cdc_demo
SQLSERVER_USER=cdc_owner
SQLSERVER_PASSWORD=Cdc_owner_pw1!
# Least-privilege login of the mssql_cdc source (SELECT on dbo.orders and cdc.dbo_orders_CT).
SQLSERVER_CDC_USER=cdc_reader
SQLSERVER_CDC_PASSWORD=Cdc_reader_pw1!
